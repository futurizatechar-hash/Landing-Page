---
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className = 'h-10 w-auto' } = Astro.props;
const isDark = variant === 'dark';
const fFill = isDark ? '#00E5FF' : '#0A192F';
const tFill = isDark ? '#FF6B35' : '#C2410C';
const wordPrimary = isDark ? '#FFFFFF' : '#0A192F';
const wordSecondary = isDark ? '#FF6B35' : '#C2410C';
---

<svg
  viewBox="0 0 250 52"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label="FuturizaTech"
>
  <g transform="translate(2, 2)">
    <path
      d="M6 10C6 8.89543 6.89543 8 8 8H19.5L16 14.5H13V21H20.5V27H13V38C13 39.1046 12.1046 40 11 40H8C6.89543 40 6 39.1046 6 38V10Z"
      fill={fFill}
    />
    <path
      d="M21 8H39C40.1046 8 41 8.89543 41 10V12.5C41 13.6046 40.1046 14.5 39 14.5H34.5V38C34.5 39.1046 33.6046 40 32.5 40H29.5C28.3954 40 27.5 39.1046 27.5 38V14.5H17.5L21 8Z"
      fill={tFill}
    />
  </g>
  <text
    x="56"
    y="34"
    font-family="'Montserrat', system-ui, -apple-system, sans-serif"
    font-size="25"
    font-weight="800"
    letter-spacing="-0.5px"
  >
    <tspan fill={wordPrimary}>Futuriza</tspan><tspan fill={wordSecondary}>Tech</tspan>
  </text>
</svg>
