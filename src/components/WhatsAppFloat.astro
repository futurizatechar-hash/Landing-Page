---
import { SITE_CONFIG } from '../data/site';
---

<a
  href={SITE_CONFIG.whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-track-whatsapp="floating_button"
  aria-label="Consultar directo por WhatsApp con FuturizaTech"
  class="group fixed bottom-5 right-5 z-40 inline-flex items-center gap-2.5 rounded-full bg-brand-whatsapp px-4 py-3 font-display text-xs font-bold text-white shadow-lg shadow-brand-whatsapp/30 transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#20ba59] hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white sm:px-5 sm:py-3.5 sm:text-sm"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-5 w-5 shrink-0"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
  </svg>
  <span class="hidden sm:inline">WhatsApp Directo</span>
</a>
