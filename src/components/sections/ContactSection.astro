---
import { SITE_CONFIG, PAIN_OPTIONS } from '../../data/site';
---

<section
  id="contacto"
  class="relative overflow-hidden border-t border-slate-200 bg-slate-50 py-16 sm:py-20 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <span class="inline-block rounded-full border border-slate-200 bg-white px-3.5 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-brand-accent">
        Paso Inicial Sin Riesgo
      </span>
      <h2 class="mt-3 font-display text-2xl font-extrabold text-brand-dark sm:text-4xl">
        Revisemos tu negocio en 15 minutos, sin cargo y sin compromiso
      </h2>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        Dejanos tus datos o elegí horario directo. Miramos tus números y procesos actuales y te decimos con franqueza qué te conviene instalar primero.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-5xl overflow-hidden rounded-3xl border border-slate-200/90 bg-white shadow-executive lg:mt-12 lg:grid lg:grid-cols-12">
      <!-- Columna Izquierda Consultiva (Brand Dark) -->
      <div class="relative flex flex-col justify-between bg-brand-dark bg-arch-grid p-7 text-white sm:p-9 lg:col-span-5">
        <div class="space-y-5">
          <span class="inline-block rounded-lg border border-brand-cyan/30 bg-brand-surface px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-brand-cyan">
            Cero discurso de vendedor
          </span>

          <h3 class="font-display text-xl font-extrabold leading-snug text-white sm:text-2xl">
            ¿Qué te llevás de esta charla corta de 15 minutos?
          </h3>

          <p class="text-sm leading-relaxed text-slate-300">
            Antes de armar cualquier presupuesto, miramos cómo estás captando clientes y operando hoy. Si automatizar o sistematizar algo te va a ahorrar horas reales o traer facturación, te decimos qué bloque instalar y cuánto rinde. Y si hoy no te hace falta, te llevás un diagnóstico claro sin costo.
          </p>

          <div class="space-y-3 pt-2">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-400">
              ¿Preferís agendar o escribir ahora mismo?
            </p>
            <a
              href={SITE_CONFIG.calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-calendly="contact_panel"
              class="flex w-full items-center justify-center gap-2.5 rounded-xl border border-white/20 bg-white/10 px-4 py-3 font-display text-xs font-bold text-white transition-all hover:border-brand-cyan hover:bg-brand-cyan/15 hover:text-brand-cyan sm:text-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
              </svg>
              <span>Elegir horario en Calendly (15 min)</span>
            </a>

            <a
              href={SITE_CONFIG.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-whatsapp="contact_panel"
              class="flex w-full items-center justify-center gap-2.5 rounded-xl border border-brand-whatsapp/40 bg-brand-whatsapp/15 px-4 py-3 font-display text-xs font-bold text-white transition-all hover:bg-brand-whatsapp hover:text-white sm:text-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
              </svg>
              <span>Hablar directo por WhatsApp</span>
            </a>
          </div>
        </div>

        <ul class="mt-8 space-y-2 border-t border-white/10 pt-5 text-xs font-medium text-slate-300">
          <li class="flex items-center gap-2">
            <span class="font-bold text-brand-cyan" aria-hidden="true">✓</span>
            <span>Diagnóstico técnico inicial sin cargo</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="font-bold text-brand-cyan" aria-hidden="true">✓</span>
            <span>Propuesta con alcance y presupuesto cerrado</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="font-bold text-brand-cyan" aria-hidden="true">✓</span>
            <span>Respuesta directa en menos de 24 horas hábiles</span>
          </li>
        </ul>
      </div>

      <!-- Columna Derecha: Formulario Calificador conectado a leads_futuriza -->
      <div class="p-7 sm:p-9 lg:col-span-7">
        <form id="lead-capture-form" class="space-y-4">
          <input type="hidden" id="lead-cta-origin" name="cta_origin" value="formulario_directo" />

          <!-- Honeypot Anti-Spam Invisible -->
          <div class="hidden" aria-hidden="true">
            <label for="website_url">No completar este campo</label>
            <input
              type="text"
              id="website_url"
              name="website_url"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label
                for="lead-name"
                class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-600"
              >
                Nombre y Apellido *
              </label>
              <input
                id="lead-name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Ej: Martín Pereyra"
                class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-brand-dark placeholder-slate-400 transition-colors focus:border-brand-accent focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-accent"
              />
            </div>

            <div>
              <label
                for="lead-company"
                class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-600"
              >
                Empresa / Rubro *
              </label>
              <input
                id="lead-company"
                name="company"
                type="text"
                required
                autocomplete="organization"
                placeholder="Ej: Distribuidora Sur · Mayorista"
                class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-brand-dark placeholder-slate-400 transition-colors focus:border-brand-accent focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-accent"
              />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label
                for="lead-phone"
                class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-600"
              >
                WhatsApp de Contacto *
              </label>
              <input
                id="lead-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                placeholder="Ej: +54 9 351 555 1234"
                class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-brand-dark placeholder-slate-400 transition-colors focus:border-brand-accent focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-accent"
              />
            </div>

            <div>
              <label
                for="lead-email"
                class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-600"
              >
                Email Corporativo *
              </label>
              <input
                id="lead-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="martin@tuempresa.com"
                class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-brand-dark placeholder-slate-400 transition-colors focus:border-brand-accent focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-accent"
              />
            </div>
          </div>

          <div>
            <label
              for="lead-pain"
              class="block font-mono text-[11px] font-semibold uppercase tracking-wider text-slate-600"
            >
              ¿Qué buscás destrabar primero en tu empresa? *
            </label>
            <select
              id="lead-pain"
              name="pain"
              required
              class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-medium text-brand-dark transition-colors focus:border-brand-accent focus:bg-white focus:outline-none focus:ring-1 focus:ring-brand-accent"
            >
              <option value="" disabled selected>Seleccioná tu prioridad actual...</option>
              {
                PAIN_OPTIONS.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))
              }
            </select>
          </div>

          <!-- Alerta de Contingencia si falla red -->
          <div
            id="lead-error-box"
            class="hidden rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-950"
            role="alert"
          >
            <p class="font-semibold">
              Detectamos una demora en la conexión con el servidor. No pierdas tiempo: enviá tus datos precargados directo a nuestro WhatsApp con un solo clic:
            </p>
            <a
              id="lead-whatsapp-fallback"
              href={SITE_CONFIG.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-whatsapp px-4 py-3 font-display text-xs font-bold text-white transition-colors hover:bg-[#20ba59] sm:text-sm"
            >
              Enviar mi solicitud precargada por WhatsApp →
            </a>
          </div>

          <button
            id="lead-submit-btn"
            type="submit"
            class="btn-primary w-full justify-center !py-4 !text-base"
          >
            <span id="lead-submit-label">Solicitar Diagnóstico de 15 min sin Cargo</span>
            <svg
              id="lead-submit-arrow"
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>

          <p class="text-center text-[11px] text-slate-500">
            Tus datos comerciales son estrictamente confidenciales. Consultá nuestra{' '}
            <a href="/privacidad" class="font-semibold text-brand-dark underline hover:text-brand-accent">
              Política de Privacidad
            </a>.
          </p>
        </form>

        <!-- Vista de Confirmación Exitosa -->
        <div id="lead-success-box" class="hidden py-8 text-center">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-brand-cyan/30 bg-brand-dark text-brand-cyan">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </div>
          <h3 class="mt-5 font-display text-2xl font-extrabold text-brand-dark">
            ¡Recibimos los datos de tu empresa!
          </h3>
          <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-slate-600">
            Tu consulta ya ingresó a nuestro centro de operaciones. Nos vamos a contactar por WhatsApp o correo en menos de 24 horas hábiles para coordinar los 15 minutos.
          </p>
          <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a
              href={SITE_CONFIG.calendlyUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-calendly="post_submit"
              class="btn-primary !text-xs sm:!text-sm"
            >
              ¿Querés elegir día y hora ya en Calendly? →
            </a>
            <button
              id="lead-reset-btn"
              type="button"
              class="font-display text-xs font-bold text-slate-500 underline hover:text-brand-dark"
            >
              Cargar otra consulta
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const SUPABASE_URL =
    import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.VITE_SUPABASE_URL || '';
  const SUPABASE_ANON_KEY =
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY || import.meta.env.VITE_SUPABASE_ANON_KEY || '';
  const BACKUP_EMAIL_ENDPOINT =
    import.meta.env.PUBLIC_BACKUP_EMAIL_ENDPOINT ||
    import.meta.env.VITE_BACKUP_EMAIL_ENDPOINT ||
    'https://formsubmit.co/ajax/futuriza.tech.ar@gmail.com';

  const form = document.getElementById('lead-capture-form') as HTMLFormElement | null;
  const painSelect = document.getElementById('lead-pain') as HTMLSelectElement | null;
  const originInput = document.getElementById('lead-cta-origin') as HTMLInputElement | null;
  const submitBtn = document.getElementById('lead-submit-btn') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('lead-submit-label');
  const errorBox = document.getElementById('lead-error-box');
  const waFallback = document.getElementById('lead-whatsapp-fallback') as HTMLAnchorElement | null;
  const successBox = document.getElementById('lead-success-box');
  const resetBtn = document.getElementById('lead-reset-btn');

  // Telemetría global de clics en WhatsApp, Calendly y preselección contextual del dolor
  document.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement | null)?.closest(
      '[data-select-pain], [data-cta-origin], [data-track-whatsapp], [data-track-calendly]'
    ) as HTMLElement | null;
    if (!target) return;

    const painValue = target.getAttribute('data-select-pain');
    if (painValue && painSelect) {
      painSelect.value = painValue;
    }

    const ctaOrigin = target.getAttribute('data-cta-origin');
    if (ctaOrigin && originInput) {
      originInput.value = ctaOrigin;
    }

    const waOrigin = target.getAttribute('data-track-whatsapp');
    if (waOrigin && typeof (window as any).trackFuturizaEvent === 'function') {
      (window as any).trackFuturizaEvent('click_whatsapp', { placement: waOrigin });
    }

    const calOrigin = target.getAttribute('data-track-calendly');
    if (calOrigin && typeof (window as any).trackFuturizaEvent === 'function') {
      (window as any).trackFuturizaEvent('click_calendly', { placement: calOrigin });
    }
  });

  // Normalización limpia de teléfono para evitar duplicados sucios en onConflict: 'telefono'
  function normalizePhone(raw: string): string | null {
    const trimmed = raw.trim();
    if (!trimmed) return null;
    const hasPlus = trimmed.startsWith('+');
    const digits = trimmed.replace(/\D/g, '');
    if (!digits) return null;
    return hasPlus ? `+${digits}` : digits;
  }

  let lastSubmitTs = 0;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn || !submitLabel) return;

    // Control de frecuencia anti-doble clic
    const now = Date.now();
    if (now - lastSubmitTs < 4000) return;
    lastSubmitTs = now;

    const fd = new FormData(form);

    // Filtro Honeypot silencioso contra bots automatizados
    const honeypot = String(fd.get('website_url') || '').trim();
    if (honeypot.length > 0) {
      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
      return;
    }

    const name = String(fd.get('name') || '').trim();
    const company = String(fd.get('company') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const rawPhone = String(fd.get('phone') || '').trim();
    const normalizedPhone = normalizePhone(rawPhone);
    const pain = String(fd.get('pain') || '').trim();
    const ctaOrigin = String(fd.get('cta_origin') || 'formulario_directo').trim();

    submitBtn.disabled = true;
    submitLabel.textContent = 'Registrando tu solicitud...';
    errorBox?.classList.add('hidden');

    let supabaseSuccess = false;
    let emailSuccess = false;

    // 1. Inserción / actualización resiliente en Supabase (tabla leads_futuriza)
    if (SUPABASE_URL && SUPABASE_ANON_KEY) {
      try {
        const { createClient } = await import('@supabase/supabase-js');
        const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        const payload = {
          nombre: name.toUpperCase(),
          telefono: normalizedPhone,
          empresa: company.toUpperCase(),
          email: email.toLowerCase(),
          estado_embudo: 'nuevo',
          resumen_chat: `[Lead Web 2.0] Prioridad elegida: ${pain} | Origen: ${ctaOrigin}`,
        };

        const op = normalizedPhone
          ? supabase.from('leads_futuriza').upsert([payload], { onConflict: 'telefono' })
          : supabase.from('leads_futuriza').insert([payload]);

        const timeout = new Promise<{ error: { message: string; code?: string } }>((_, reject) =>
          setTimeout(() => reject(new Error('Timeout en Supabase')), 6000)
        );

        const result = (await Promise.race([op, timeout])) as {
          error?: { message: string; code?: string } | null;
        };

        if (!result?.error) {
          supabaseSuccess = true;
        } else if (result.error.code === '23505' && normalizedPhone) {
          const { error: updateErr } = await supabase
            .from('leads_futuriza')
            .update(payload)
            .eq('telefono', normalizedPhone);
          if (!updateErr) supabaseSuccess = true;
        }
      } catch (_) {
        // Continúa al respaldo por correo electrónico
      }
    }

    // 2. Canal secundario de respaldo por correo electrónico
    try {
      const emailOp = fetch(BACKUP_EMAIL_ENDPOINT, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify({
          Nombre: name,
          Empresa: company,
          WhatsApp: rawPhone || 'No informado',
          Email: email,
          'Prioridad de Negocio': pain,
          'Origen en Web': ctaOrigin,
          _subject: `Nuevo Lead Web 2.0: ${company} (${name})`,
          _template: 'table',
          _captcha: 'false',
        }),
      });

      const emailTimeout = new Promise<Response>((_, reject) =>
        setTimeout(() => reject(new Error('Timeout email')), 4500)
      );

      const resp = await Promise.race([emailOp, emailTimeout]);
      if (resp && resp.ok) {
        emailSuccess = true;
      }
    } catch (_) {
      // Si ambos fallan, se habilita el botón precargado de WhatsApp
    }

    submitBtn.disabled = false;
    submitLabel.textContent = 'Solicitar Diagnóstico de 15 min sin Cargo';

    if (supabaseSuccess || emailSuccess) {
      form.classList.add('hidden');
      successBox?.classList.remove('hidden');
      if (typeof (window as any).trackFuturizaEvent === 'function') {
        (window as any).trackFuturizaEvent('generate_lead', {
          pain_category: pain,
          cta_origin: ctaOrigin,
        });
      }
    } else {
      if (waFallback) {
        const msg =
          `Hola equipo de FuturizaTech, completé mis datos en la web para coordinar los 15 minutos:\n` +
          `• Nombre: ${name}\n` +
          `• Empresa: ${company}\n` +
          `• WhatsApp: ${rawPhone}\n` +
          `• Email: ${email}\n` +
          `• Prioridad: ${pain}`;
        waFallback.href = `https://wa.me/5493518046223?text=${encodeURIComponent(msg)}`;
      }
      errorBox?.classList.remove('hidden');
    }
  });

  resetBtn?.addEventListener('click', () => {
    form?.reset();
    successBox?.classList.add('hidden');
    form?.classList.remove('hidden');
  });
</script>
