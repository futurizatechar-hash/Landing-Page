---
import { TRUST_SEALS } from '../../data/site';
import { FAQ_ITEMS } from '../../data/faq';
---

<section id="preguntas" class="bg-white py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Panel Oscuro de los 3 Compromisos por Contrato -->
    <div class="rounded-3xl bg-brand-dark bg-arch-grid p-6 text-white shadow-executive sm:p-10 lg:p-12">
      <div class="max-w-3xl">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-brand-cyan">
          Respaldo Contractual
        </span>
        <h2 class="mt-2 font-display text-2xl font-extrabold text-white sm:text-3xl">
          Tres reglas que blindan tu inversión desde el primer día
        </h2>
        <p class="mt-2 text-sm text-slate-300 sm:text-base">
          Trabajamos exclusivamente con empresas en marcha, pymes B2B, comercios consolidados y tiendas online en crecimiento que buscan orden real y resultados medibles.
        </p>
      </div>

      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {
          TRUST_SEALS.map((seal, index) => (
            <div class="rounded-2xl border border-white/10 bg-brand-surface/85 p-5 sm:p-6">
              <span class="font-mono text-xs font-semibold text-brand-glow">
                SELLO OFICIAL 0{index + 1}
              </span>
              <h3 class="mt-2 font-display text-lg font-bold text-white">
                {seal.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-slate-300">
                {seal.fullDesc}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Acordeón de 7 Preguntas Frecuentes -->
    <div class="mx-auto mt-14 max-w-4xl sm:mt-16">
      <div class="text-center">
        <span class="inline-block rounded-full border border-slate-200 bg-slate-50 px-3.5 py-1 font-mono text-xs font-semibold uppercase tracking-wider text-brand-accent">
          Respuestas sin Letra Chica
        </span>
        <h2 class="mt-3 font-display text-2xl font-extrabold text-brand-dark sm:text-4xl">
          Preguntas frecuentes antes de agendar tu diagnóstico
        </h2>
      </div>

      <div class="mt-8 space-y-3.5 sm:mt-10">
        {
          FAQ_ITEMS.map((faq, idx) => (
            <details
              class="group rounded-2xl border border-slate-200 bg-slate-50/60 transition-colors open:border-brand-dark/25 open:bg-white open:shadow-sm"
              open={idx === 0}
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-display text-sm font-bold text-brand-dark sm:px-6 sm:py-5 sm:text-base">
                <span>{faq.question}</span>
                <span class="faq-chevron flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-white text-brand-accent transition-transform duration-200">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div class="border-t border-slate-100 px-5 pb-5 pt-3.5 text-sm leading-relaxed text-slate-600 sm:px-6 sm:pb-6 sm:text-base">
                {faq.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
