---
import LogoVertical from './brand/LogoVertical.astro';
import { SITE_CONFIG, NAV_LINKS } from '../data/site';
---

<footer class="border-t border-white/10 bg-brand-deep text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12">
      <!-- Columna Marca -->
      <div class="space-y-5 lg:col-span-5">
        <a
          href="/"
          class="inline-block rounded-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan"
          aria-label="FuturizaTech — Inicio"
        >
          <LogoVertical variant="dark" class="h-24 w-auto" />
        </a>
        <p class="max-w-md text-sm leading-relaxed text-slate-400">
          Ingeniería de software, sistemas de gestión a medida y automatización de herramientas de marketing para empresas que buscan captar clientes constantes y operar en orden sin licencias por empleado.
        </p>

        <div class="flex items-center gap-3 pt-1">
          <a
            href={SITE_CONFIG.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de FuturizaTech"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-all hover:border-brand-glow hover:bg-brand-accent hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-whatsapp="footer"
            aria-label="Escribir por WhatsApp a FuturizaTech"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-all hover:border-brand-whatsapp hover:bg-brand-whatsapp hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-calendly="footer"
            aria-label="Agendar diagnóstico de 15 minutos en Calendly"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-all hover:border-brand-cyan hover:bg-brand-cyan/15 hover:text-brand-cyan"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
          </a>
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            aria-label="Enviar correo electrónico a FuturizaTech"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 transition-all hover:border-brand-glow hover:bg-brand-accent hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna Navegación -->
      <div class="space-y-4 lg:col-span-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-cyan">
          Recorrido Comercial
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/#contacto"
              class="font-semibold text-brand-glow transition-colors hover:text-white"
            >
              Diagnóstico de 15 min sin cargo →
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna Contacto Directo -->
      <div class="space-y-4 lg:col-span-4">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-cyan">
          Sede &amp; Canales Oficiales
        </h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-brand-glow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span>
              <strong class="font-semibold text-white">Córdoba, Argentina</strong><br />
              Operativa 100% remota para todo el país y Latinoamérica
            </span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-brand-whatsapp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <a
              href={SITE_CONFIG.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track-whatsapp="footer_phone"
              class="transition-colors hover:text-white"
            >
              WhatsApp: {SITE_CONFIG.phoneDisplay}
            </a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <a
              href={`mailto:${SITE_CONFIG.email}`}
              class="transition-colors hover:text-white"
            >
              {SITE_CONFIG.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row">
      <p>© 2026 FuturizaTech. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="/privacidad" class="transition-colors hover:text-white">
          Política de Privacidad
        </a>
        <a href="/terminos" class="transition-colors hover:text-white">
          Términos y Condiciones
        </a>
      </div>
    </div>
  </div>
</footer>
