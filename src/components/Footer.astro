---
import LogoHorizontal from './brand/LogoHorizontal.astro';
import { SITE_CONFIG, NAV_LINKS } from '../data/site';

const FOOTER_PILLARS = [
  {
    num: '01',
    label: 'Automatización de Marketing',
    pain: 'Conseguir clientes constantes / Automatizar mi marketing (Pilar 1)',
  },
  {
    num: '02',
    label: 'Plataformas Web & Conversión',
    pain: 'Nueva plataforma web rápida / Medir bien mis anuncios (Pilar 2)',
  },
  {
    num: '03',
    label: 'Sistemas de Gestión (ERP / CRM)',
    pain: 'Ordenar mi operación interna / Salir de planillas de Excel (Pilar 3)',
  },
  {
    num: '04',
    label: 'Automatización & Agentes IA',
    pain: 'Integrar sistemas / Asistentes IA 24/7 (Pilar 4)',
  },
] as const;
---

<footer
  id="site-footer"
  class="relative overflow-hidden bg-brand-deep bg-arch-grid text-slate-300"
>
  <!-- Borde arquitectónico superior luminoso -->
  <div
    class="h-[2px] w-full bg-gradient-to-r from-brand-cyan/40 via-brand-glow/70 to-brand-cyan/30"
    aria-hidden="true"
  ></div>

  <!-- Halo sutil de profundidad -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[620px] -translate-x-1/2 rounded-full bg-brand-cyan/[0.06] blur-[110px]"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl px-4 pb-10 pt-12 sm:px-6 lg:px-8 lg:pb-12 lg:pt-16">
    <!-- Franja Ejecutiva Superior de Conversión -->
    <div class="rounded-2xl border border-white/10 bg-gradient-to-br from-brand-dark via-brand-surface/95 to-brand-dark p-6 shadow-executive sm:p-8 lg:flex lg:items-center lg:justify-between lg:gap-8">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-brand-cyan/25 bg-brand-deep/70 px-3 py-1">
          <span class="h-2 w-2 rounded-full bg-brand-cyan" aria-hidden="true"></span>
          <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-brand-cyan">
            Diagnóstico Ejecutivo · 15 Minutos Sin Cargo
          </span>
        </div>
        <h2 class="mt-3 font-display text-xl font-extrabold leading-snug text-white sm:text-2xl">
          ¿Querés saber qué bloque te conviene instalar primero en tu empresa?
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-slate-300">
          Revisamos cómo captás clientes y operás hoy. Te llevás una hoja de ruta concreta, con alcance por contrato y presupuesto cerrado.
        </p>
      </div>

      <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center lg:mt-0 lg:shrink-0">
        <a
          href="/#contacto"
          data-cta-origin="footer_banner"
          class="btn-primary whitespace-nowrap !px-5 !py-3 !text-xs sm:!text-sm"
        >
          <span>Solicitar Diagnóstico</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a
          href={SITE_CONFIG.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track-whatsapp="footer_banner"
          class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-white/15 bg-white/[0.04] px-5 py-3 font-display text-xs font-bold text-white transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-whatsapp hover:bg-brand-whatsapp/15 hover:text-brand-whatsapp sm:text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0 text-brand-whatsapp"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"></path>
          </svg>
          <span>Hablar por WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- Grilla Principal de 4 Columnas Balanceadas -->
    <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- Columna 1: Identidad Alineada a Izquierda & Sellos (4 cols) -->
      <div class="sm:col-span-2 lg:col-span-4">
        <a
          href="/"
          class="inline-flex items-center rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan"
          aria-label="FuturizaTech — Inicio"
        >
          <LogoHorizontal variant="dark" class="h-9 w-auto" />
        </a>

        <p class="mt-2 font-mono text-[11px] font-semibold uppercase tracking-wider text-brand-cyan">
          Ingeniería de Software &amp; Automatización
        </p>

        <p class="mt-3.5 max-w-sm text-sm leading-relaxed text-slate-400">
          Programamos e instalamos sistemas de gestión a medida, plataformas web veloces y herramientas automáticas de marketing. Todo queda 100% a nombre de tu empresa, sin alquiler ni licencias por empleado.
        </p>

        <!-- Sellos Técnicos Compactos -->
        <div class="mt-4 flex flex-wrap gap-2">
          <span class="rounded-md border border-white/10 bg-brand-surface/75 px-2.5 py-1 font-mono text-[11px] font-medium text-slate-300">
            100% tu propiedad
          </span>
          <span class="rounded-md border border-white/10 bg-brand-surface/75 px-2.5 py-1 font-mono text-[11px] font-medium text-slate-300">
            Garantías por contrato
          </span>
          <span class="rounded-md border border-white/10 bg-brand-surface/75 px-2.5 py-1 font-mono text-[11px] font-medium text-slate-300">
            Escala modular
          </span>
        </div>

        <!-- Accesos Sociales y Directos -->
        <div class="mt-5 flex items-center gap-2.5">
          <a
            href={SITE_CONFIG.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de FuturizaTech"
            title="Instagram"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-brand-surface/75 text-slate-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-glow hover:bg-brand-accent hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-whatsapp="footer_social"
            aria-label="Escribir por WhatsApp a FuturizaTech"
            title="WhatsApp Directo"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-brand-surface/75 text-slate-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-whatsapp hover:bg-brand-whatsapp hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"></path>
            </svg>
          </a>
          <a
            href={SITE_CONFIG.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-calendly="footer_social"
            aria-label="Agendar diagnóstico de 15 minutos en Calendly"
            title="Agendar en Calendly"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-brand-surface/75 text-slate-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-cyan hover:bg-brand-cyan/15 hover:text-brand-cyan"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
          </a>
          <a
            href={`mailto:${SITE_CONFIG.email}`}
            aria-label="Enviar correo electrónico a FuturizaTech"
            title="Enviar correo"
            class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-brand-surface/75 text-slate-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-glow hover:bg-brand-accent hover:text-white"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Los 4 Pilares de Servicio (3 cols) -->
      <div class="lg:col-span-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-cyan">
          Los 4 Pilares
        </h3>
        <ul class="mt-4 space-y-3 text-sm">
          {
            FOOTER_PILLARS.map((pillar) => (
              <li>
                <a
                  href="/#pilares"
                  class="group inline-flex items-start gap-2.5 text-slate-400 transition-colors hover:text-white"
                >
                  <span class="mt-0.5 font-mono text-[11px] font-semibold text-brand-cyan/75 transition-colors group-hover:text-brand-cyan">
                    {pillar.num}
                  </span>
                  <span class="leading-snug">{pillar.label}</span>
                </a>
              </li>
            ))
          }
          <li class="pt-1">
            <a
              href="/#como-trabajamos"
              class="inline-flex items-center gap-1.5 whitespace-nowrap font-mono text-xs font-semibold text-slate-300 transition-colors hover:text-brand-cyan"
            >
              <span>Auditorías en 3 a 7 días</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Navegación Rápida sin líneas huérfanas (2 cols) -->
      <div class="lg:col-span-2">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-cyan">
          Navegación
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="whitespace-nowrap text-slate-400 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="pt-1">
            <a
              href="/#contacto"
              data-cta-origin="footer_nav"
              class="inline-flex items-center gap-1.5 whitespace-nowrap font-semibold text-brand-glow transition-colors hover:text-white"
            >
              <span>Diagnóstico sin cargo</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Sede & Canales Oficiales Estructurados (3 cols) -->
      <div class="lg:col-span-3">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-widest text-brand-cyan">
          Sede &amp; Canales Oficiales
        </h3>

        <div class="mt-4 space-y-2.5 text-sm">
          <div class="flex items-start gap-3 rounded-xl border border-white/[0.08] bg-brand-surface/50 px-3.5 py-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-4 w-4 shrink-0 text-brand-glow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <div class="text-xs leading-relaxed text-slate-400">
              <strong class="block font-semibold text-white">Córdoba, Argentina</strong>
              <span>Operativa 100% remota en Argentina y LatAm</span>
            </div>
          </div>

          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-whatsapp="footer_phone"
            class="group flex items-center justify-between gap-2 rounded-xl border border-white/[0.08] bg-brand-surface/50 px-3.5 py-2.5 transition-all hover:border-brand-whatsapp/45 hover:bg-brand-surface/90"
          >
            <span class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-brand-whatsapp" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"></path>
              </svg>
              <span class="whitespace-nowrap font-mono text-xs font-medium text-slate-200 group-hover:text-white">
                {SITE_CONFIG.phoneDisplay}
              </span>
            </span>
            <span class="font-mono text-[10px] text-slate-500 group-hover:text-brand-whatsapp">↗</span>
          </a>

          <a
            href={`mailto:${SITE_CONFIG.email}`}
            class="group flex items-center justify-between gap-2 rounded-xl border border-white/[0.08] bg-brand-surface/50 px-3.5 py-2.5 transition-all hover:border-brand-cyan/45 hover:bg-brand-surface/90"
          >
            <span class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span class="whitespace-nowrap text-xs font-medium text-slate-200 group-hover:text-white">
                {SITE_CONFIG.email}
              </span>
            </span>
            <span class="font-mono text-[10px] text-slate-500 group-hover:text-brand-cyan">↗</span>
          </a>

          <a
            href={SITE_CONFIG.calendlyUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track-calendly="footer_card"
            class="group flex items-center justify-between gap-2 rounded-xl border border-white/[0.08] bg-brand-surface/50 px-3.5 py-2.5 transition-all hover:border-brand-glow/45 hover:bg-brand-surface/90"
          >
            <span class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-brand-glow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" x2="16" y1="2" y2="6"></line>
                <line x1="8" x2="8" y1="2" y2="6"></line>
                <line x1="3" x2="21" y1="10" y2="10"></line>
              </svg>
              <span class="whitespace-nowrap text-xs font-medium text-slate-200 group-hover:text-white">
                Agendar llamada en Calendly
              </span>
            </span>
            <span class="font-mono text-[10px] text-slate-500 group-hover:text-brand-glow">↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra Legal e Institucional Inferior -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-slate-400 sm:flex-row">
      <p>© 2026 FuturizaTech · Córdoba, Argentina. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="/privacidad" class="whitespace-nowrap transition-colors hover:text-white">
          Política de Privacidad
        </a>
        <a href="/terminos" class="whitespace-nowrap transition-colors hover:text-white">
          Términos y Condiciones
        </a>
      </div>
    </div>
  </div>
</footer>
