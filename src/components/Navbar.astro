---
import LogoHorizontal from './brand/LogoHorizontal.astro';
import { NAV_LINKS } from '../data/site';
---

<header
  id="site-navbar"
  class="sticky top-0 z-50 border-b border-white/10 bg-brand-deep/95 backdrop-blur-md transition-colors duration-200"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a
      href="/"
      class="flex items-center rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan"
      aria-label="FuturizaTech — Ir al inicio"
    >
      <LogoHorizontal variant="dark" class="h-9 w-auto sm:h-10" />
    </a>

    <nav class="hidden lg:flex lg:items-center lg:gap-7" aria-label="Navegación principal">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-sm font-semibold text-slate-300 transition-colors duration-200 hover:text-white focus-visible:outline-none focus-visible:text-brand-cyan"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden lg:flex lg:items-center lg:gap-3">
      <a
        href="/#contacto"
        data-cta-origin="navbar"
        class="btn-primary !px-5 !py-2.5 !text-xs sm:!text-sm"
      >
        <span>Diagnóstico sin Cargo (15 min)</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-xl border border-white/15 bg-white/5 p-2.5 text-white transition-colors hover:border-brand-cyan hover:text-brand-cyan lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu-panel"
      aria-label="Abrir menú de navegación"
    >
      <svg
        id="icon-menu-open"
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg
        id="icon-menu-close"
        xmlns="http://www.w3.org/2000/svg"
        class="hidden h-5 w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Menú Móvil Desplegable -->
  <div
    id="mobile-menu-panel"
    class="hidden border-t border-white/10 bg-brand-deep px-4 pb-5 pt-3 lg:hidden"
  >
    <nav class="flex flex-col space-y-1" aria-label="Navegación móvil">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-200 transition-colors hover:bg-white/5 hover:text-brand-cyan"
          >
            {link.label}
          </a>
        ))
      }
      <div class="pt-3">
        <a
          href="/#contacto"
          data-cta-origin="navbar_mobile"
          class="mobile-nav-link btn-primary w-full justify-center"
        >
          <span>Agendar Diagnóstico (15 min)</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu-panel');
  const openIcon = document.getElementById('icon-menu-open');
  const closeIcon = document.getElementById('icon-menu-close');

  const closeMenu = () => {
    if (!toggleBtn || !panel || !openIcon || !closeIcon) return;
    panel.classList.add('hidden');
    openIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
    toggleBtn.setAttribute('aria-expanded', 'false');
  };

  toggleBtn?.addEventListener('click', () => {
    if (!panel || !openIcon || !closeIcon) return;
    const isHidden = panel.classList.contains('hidden');
    if (isHidden) {
      panel.classList.remove('hidden');
      openIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeMenu();
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
