---
import LogoHorizontal from './brand/LogoHorizontal.astro';
import { NAV_LINKS, SITE_CONFIG } from '../data/site';
---

<header
  id="site-navbar"
  class="sticky top-0 z-50 border-b border-white/[0.08] bg-brand-deep/90 backdrop-blur-xl transition-shadow duration-300"
>
  <!-- Línea de luz arquitectónica sutil inferior -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-brand-cyan/35 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:h-[72px] sm:px-6 lg:px-8">
    <!-- Identidad Oficial (Siempre en 1 línea, sin encogerse) -->
    <a
      href="/"
      class="flex shrink-0 items-center rounded-lg py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan"
      aria-label="FuturizaTech — Ir al inicio"
    >
      <LogoHorizontal variant="dark" class="h-8 w-auto shrink-0 xl:h-9" />
    </a>

    <!-- Cápsula Arquitectónica de Navegación (Desktop >= 1024px, cero saltos de línea) -->
    <nav
      class="hidden lg:flex lg:items-center lg:gap-0.5 lg:rounded-full lg:border lg:border-white/[0.09] lg:bg-brand-surface/75 lg:p-1 lg:shadow-[inset_0_1px_0_rgba(255,255,255,0.06)]"
      aria-label="Navegación principal"
    >
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            data-nav-target={link.href.replace('/#', '')}
            class="nav-pill-link whitespace-nowrap rounded-full px-3 py-1.5 text-[13px] font-semibold text-slate-300 transition-all duration-200 hover:bg-white/[0.08] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan xl:px-4 xl:text-sm"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Acciones Ejecutivas Derecha (Desktop >= 1024px) -->
    <div class="hidden lg:flex lg:shrink-0 lg:items-center lg:gap-2.5">
      <a
        href={SITE_CONFIG.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-track-whatsapp="navbar"
        aria-label="Consultar directo por WhatsApp"
        title="Consultar por WhatsApp"
        class="hidden h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-brand-surface/70 text-slate-300 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-whatsapp/50 hover:bg-brand-whatsapp/15 hover:text-brand-whatsapp focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-whatsapp xl:inline-flex"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-[18px] w-[18px]"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"></path>
        </svg>
      </a>

      <a
        href="/#contacto"
        data-cta-origin="navbar"
        class="group inline-flex shrink-0 items-center gap-2 whitespace-nowrap rounded-xl border border-brand-glow/35 bg-brand-accent px-4 py-2.5 font-display text-[13px] font-bold text-white shadow-[0_4px_20px_rgba(194,65,12,0.32)] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#C93C06] hover:shadow-glow-orange focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-glow xl:px-5 xl:text-sm"
      >
        <span>Diagnóstico sin Cargo</span>
        <span class="hidden items-center rounded-md bg-black/25 px-1.5 py-0.5 font-mono text-[11px] font-semibold text-orange-100 xl:inline-flex">
          15 min
        </span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Controles Móvil / Tablet (< 1024px) -->
    <div class="flex shrink-0 items-center gap-2 lg:hidden">
      <a
        href="/#contacto"
        data-cta-origin="navbar_tablet"
        class="hidden items-center gap-1.5 whitespace-nowrap rounded-xl border border-brand-glow/35 bg-brand-accent px-3.5 py-2 font-display text-xs font-bold text-white shadow-sm transition-colors hover:bg-[#C93C06] sm:inline-flex"
      >
        <span>Diagnóstico</span>
        <span class="font-mono text-[10px] text-orange-100">15m</span>
      </a>

      <button
        id="mobile-menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-brand-surface/80 text-white transition-colors hover:border-brand-cyan hover:text-brand-cyan focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        aria-label="Abrir menú de navegación"
      >
        <svg
          id="icon-menu-open"
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="4" x2="20" y1="7" y2="7"></line>
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="8" x2="20" y1="17" y2="17"></line>
        </svg>
        <svg
          id="icon-menu-close"
          xmlns="http://www.w3.org/2000/svg"
          class="hidden h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Panel Móvil / Tablet Desplegable -->
  <div
    id="mobile-menu-panel"
    class="hidden border-t border-white/10 bg-brand-deep/98 px-4 pb-6 pt-3 shadow-2xl backdrop-blur-xl sm:px-6 lg:hidden"
  >
    <nav class="flex flex-col space-y-1.5" aria-label="Navegación móvil">
      {
        NAV_LINKS.map((link, idx) => (
          <a
            href={link.href}
            class="mobile-nav-link group flex items-center justify-between rounded-xl border border-transparent bg-white/[0.02] px-3.5 py-3 text-sm font-semibold text-slate-200 transition-all hover:border-white/10 hover:bg-brand-surface/80 hover:text-white"
          >
            <span class="flex items-center gap-3">
              <span class="font-mono text-xs font-semibold text-brand-cyan/80">
                0{idx + 1}
              </span>
              <span>{link.label}</span>
            </span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-slate-500 transition-transform group-hover:translate-x-0.5 group-hover:text-brand-cyan"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </a>
        ))
      }

      <div class="grid gap-2.5 pt-3 sm:grid-cols-2">
        <a
          href="/#contacto"
          data-cta-origin="navbar_mobile"
          class="mobile-nav-link btn-primary w-full justify-center whitespace-nowrap !py-3 !text-xs sm:!text-sm"
        >
          <span>Diagnóstico sin Cargo (15 min)</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>

        <a
          href={SITE_CONFIG.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track-whatsapp="navbar_mobile"
          class="mobile-nav-link inline-flex w-full items-center justify-center gap-2 whitespace-nowrap rounded-xl border border-white/15 bg-brand-surface/80 px-4 py-3 font-display text-xs font-bold text-white transition-colors hover:border-brand-whatsapp hover:text-brand-whatsapp sm:text-sm"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 shrink-0 text-brand-whatsapp"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01Zm-7.01 15.24c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.264 8.264 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c.02 4.54-3.68 8.23-8.22 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"></path>
          </svg>
          <span>Consultar por WhatsApp</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const navbar = document.getElementById('site-navbar');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const panel = document.getElementById('mobile-menu-panel');
  const openIcon = document.getElementById('icon-menu-open');
  const closeIcon = document.getElementById('icon-menu-close');
  const navPills = document.querySelectorAll<HTMLAnchorElement>('.nav-pill-link[data-nav-target]');

  const closeMenu = () => {
    if (!toggleBtn || !panel || !openIcon || !closeIcon) return;
    panel.classList.add('hidden');
    openIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
    toggleBtn.setAttribute('aria-expanded', 'false');
  };

  toggleBtn?.addEventListener('click', () => {
    if (!panel || !openIcon || !closeIcon) return;
    const isHidden = panel.classList.contains('hidden');
    if (isHidden) {
      panel.classList.remove('hidden');
      openIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
    } else {
      closeMenu();
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Elevación sutil del header al hacer scroll y resaltado activo de sección
  const syncNavbarScrollState = () => {
    if (navbar) {
      if (window.scrollY > 16) {
        navbar.classList.add('shadow-[0_10px_30px_rgba(2,6,23,0.65)]');
      } else {
        navbar.classList.remove('shadow-[0_10px_30px_rgba(2,6,23,0.65)]');
      }
    }
  };

  window.addEventListener('scroll', syncNavbarScrollState, { passive: true });
  syncNavbarScrollState();

  if (navPills.length > 0 && 'IntersectionObserver' in window) {
    const setActivePill = (id: string | null) => {
      navPills.forEach((pill) => {
        const match = id && pill.dataset.navTarget === id;
        pill.classList.toggle('bg-white/[0.11]', Boolean(match));
        pill.classList.toggle('text-white', Boolean(match));
        pill.classList.toggle('text-slate-300', !match);
      });
    };

    const sectionObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActivePill(entry.target.id);
          }
        }
      },
      { rootMargin: '-28% 0px -60% 0px', threshold: 0 }
    );

    navPills.forEach((pill) => {
      const targetId = pill.dataset.navTarget;
      const sectionEl = targetId ? document.getElementById(targetId) : null;
      if (sectionEl) sectionObserver.observe(sectionEl);
    });
  }
</script>
