---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<BaseLayout
  title="Página no encontrada (404) | FuturizaTech"
  description="La dirección que buscás no existe o fue movida. Volvé al inicio de FuturizaTech."
  canonicalPath="/404"
  noindex={true}
>
  <Navbar />
  <main id="contenido-principal" class="flex flex-1 items-center justify-center bg-brand-deep bg-arch-grid px-4 py-20 text-white">
    <div class="mx-auto max-w-xl text-center">
      <span class="inline-block rounded-full border border-brand-cyan/30 bg-brand-surface px-3.5 py-1 font-mono text-xs font-semibold text-brand-cyan">
        ERROR HTTP 404
      </span>
      <h1 class="mt-4 font-display text-3xl font-extrabold text-white sm:text-5xl">
        Esta dirección no existe o cambió de lugar
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-slate-300 sm:text-base">
        Volvé a la portada principal para explorar nuestros 4 pilares técnicos, casos en producción o coordinar tu diagnóstico de 15 minutos sin cargo.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">
          Ir a la página principal →
        </a>
        <a href="/#contacto" class="btn-secondary-dark">
          Agendar Diagnóstico (15 min)
        </a>
      </div>
    </div>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
