# ==============================================================================
# FuturizaTech Web — Plantilla de Variables de Entorno (.env.example)
# Copiá este archivo a `.env` para desarrollo local. Nunca subas `.env` a Git.
# El proyecto soporta tanto prefijo PUBLIC_* (Astro) como VITE_* (Cloudflare).
# ==============================================================================

# 1. Conexión a Supabase CRM (Tabla: leads_futuriza)
PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="tu_publishable_o_anon_key"

# Compatibilidad opcional con variables preexistentes en Cloudflare Pages:
# VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
# VITE_SUPABASE_ANON_KEY="tu_publishable_o_anon_key"

# 2. Canal secundario de respaldo por correo electrónico (FormSubmit / Webhook)
PUBLIC_BACKUP_EMAIL_ENDPOINT="https://formsubmit.co/ajax/info@futurizatech.com"

# 3. Medición Técnica (Google Tag Manager — dejar vacío si aún no se activa)
PUBLIC_GTM_ID=""
